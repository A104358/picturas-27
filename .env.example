# Copy to .env and edit to override non-secret settings of docker-compose.yaml.
# Secrets never go here: they live outside the checkout, in $PICTURAS_SECRETS_DIR.
#
# First run on a machine (each installation has its own secrets and CA; never copy them between machines):
#   export PICTURAS_SECRETS_DIR=$HOME/.picturas-secrets   # any directory outside the repository
#   ops/secrets.sh init      # session secret, RS256 pair, broker/S3/Mongo credentials, env files
#   ops/pki.sh init          # installation CA (365 days) and one certificate per service (30 days)
#   ops/pki.sh check         # before every start; `ops/pki.sh renew` when a certificate has 7 days left
#   docker compose up -d --build
