# ficheiros do macOS
.DS_Store

# Node modules — nunca devem ir para o repo
node_modules/

# ficheiros gerados automaticamente
package-lock.json

backups/

# ficheiros de ambiente locais (nunca devem ir para o repo)
.env

# cache do Python
__pycache__/
*.py[cod]
.venv/

# avaliação da Fase 2 (evaluation/med.py)
evaluation/.corpus/
evaluation/.run/
evaluation/.env.med
evaluation/.venv/

# Fase 2 (B1): segredos, chaves e certificados nunca ficam no checkout.
# Ficam em $PICTURAS_SECRETS_DIR, gerados por ops/secrets.sh e ops/pki.sh.
*.key
*.pem
*.p12
*.pfx
*.crt
**/certs/
secrets/
.env.*
!.env.example
!**/.env.example
!evaluation/.env.med.example
