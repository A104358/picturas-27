# Copy to evaluation/.env.med (ignored by Git). Empty values = baseline (BF) defaults.
MED_COMPOSE_PROJECT=picturas-nfr
MED_BASE_URL=https://localhost:28080
MED_PORT_OFFSET=20000
MED_BASE_COMMIT=0523102
MED_MIN_FREE_GIB=60
# Client-side CA for the public nginx (empty = verification off, recorded in the manifest)
MED_CACERT=

# Admin access used ONLY by fixtures/cleanup/verification (never by attack cases).
# BF: empty -> no authentication. MF: URIs with admin credentials.
MED_ADMIN_MONGO_URI_PROJECTS=
MED_ADMIN_MONGO_URI_USERS=
MED_ADMIN_MONGO_URI_SUBSCRIPTIONS=
MED_RABBIT_ADMIN=
MED_S3_ADMIN=
MED_S3_BUCKET=picturas

# Data-channel TLS (empty = BF transport). CA paths are mounted read-only in the probe.
MED_S3_SCHEME=
MED_S3_CA_FILE=
MED_AMQP_PORT=
MED_AMQP_CA_FILE=
MED_RABBIT_MGMT_SCHEME=
MED_RABBIT_MGMT_PORT=
MED_RABBIT_MGMT_CA_FILE=
MED_MONGO_TLS_CA_FILE=

# Legitimate per-service credentials (MF), user:password. Used only in the
# "credential of another service" / "own credential beyond privilege" cases.
MED_SVC_CRED_MONGO_PROJECTS=
MED_SVC_CRED_MONGO_USERS=
MED_SVC_CRED_MONGO_SUBSCRIPTIONS=
MED_MONGO_AUTHSOURCE=admin
MED_SVC_CRED_RABBIT_BRIGHTNESS_TOOL=
MED_SVC_CRED_S3_IMG_STORAGE=

# Internal schemes if they change in the MF (http/https)
MED_SVC_SCHEME_PROJECTS=
MED_SVC_SCHEME_USERS=
MED_SVC_SCHEME_SUBSCRIPTIONS=
MED_SVC_SCHEME_IMG_STORAGE=

# Directory with legitimate client certificates (mTLS controls only), mounted in the probe
MED_CLIENT_CERT_DIR=
