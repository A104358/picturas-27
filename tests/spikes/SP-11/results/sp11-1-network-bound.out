## 2 S3 still works end-to-end (put/get/copy/presigned) with gRPC mTLS
DENY   git_default list_buckets  [InvalidAccessKeyId 403]
ALLOW  img_storage put users/u/projects/p/src/a.png
ALLOW  img_storage get
ALLOW  img_storage copy src->out
DENY   img_storage get other/x  [AccessDenied 403]
DENY   img_storage put other/y  [AccessDenied 403]
DENY   img_storage put_bucket_policy  [AccessDenied 403]
DENY   img_storage put_bucket_acl public-read  [AccessDenied 403]
presigned GET (img_storage) -> 200
presigned PUT staging (uploader) -> 200
presigned PUT outside staging (uploader) -> 403
## 3 probe each port from another container
  port 9333   plain-http=400   tls-without-client-cert=client-cert-required   https-with-img_storage-cert=200
  port 19333  plain-http=000   tls-without-client-cert=client-cert-required   https-with-img_storage-cert=000
  port 8080   plain-http=400   tls-without-client-cert=client-cert-required   https-with-img_storage-cert=400
  port 18080  plain-http=000   tls-without-client-cert=tls-ok-no-cert         https-with-img_storage-cert=000
  port 8888   plain-http=400   tls-without-client-cert=client-cert-required   https-with-img_storage-cert=200
  port 18888  plain-http=000   tls-without-client-cert=client-cert-required   https-with-img_storage-cert=000
  port 9000   plain-http=400   tls-without-client-cert=tls-ok-no-cert         https-with-img_storage-cert=403
  port 19000  plain-http=000   tls-without-client-cert=tls-ok-no-cert         https-with-img_storage-cert=000
